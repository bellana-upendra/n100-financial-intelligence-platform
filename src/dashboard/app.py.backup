# ============================================================
# COMMON COMPONENTS
# ============================================================

def show_page_header(title: str, description: str) -> None:
    """Display a consistent heading on every page."""

    st.title(title)
    st.caption(description)
    st.divider()


def company_selector(label: str = "Select company") -> str:
    """Display a reusable company selector."""

    return st.selectbox(
        label,
        options=SAMPLE_COMPANIES["Ticker"].tolist(),
    )


# ============================================================
# PAGE 1 — HOME
# ============================================================

def home_page() -> None:
    show_page_header(
        "🏠 Home / Overview",
        "NIFTY 100 financial analytics, screening and valuation dashboard.",
    )

    col1, col2, col3, col4 = st.columns(4)

    col1.metric("Companies", "92")
    col2.metric("Dashboard Pages", "8")
    col3.metric("Peer Groups", "11")
    col4.metric("Application Status", "Running")

    st.subheader("Dashboard modules")

    st.info(
        """
        Use the navigation menu on the left to open:

        **Company Profile · Stock Screener · Peer Comparison ·
        Financial Trends · Sector Analysis · Capital Allocation ·
        Annual Reports**
        """
    )

    st.subheader("Sample company data")

    st.dataframe(
        SAMPLE_COMPANIES,
        width="stretch",
        hide_index=True,
    )


# ============================================================
# PAGE 2 — COMPANY PROFILE
# ============================================================

def company_profile_page() -> None:
    show_page_header(
        "🏢 Company Profile",
        "Review the financial profile and key performance indicators.",
    )

    ticker = company_selector()

    company = SAMPLE_COMPANIES.loc[
        SAMPLE_COMPANIES["Ticker"] == ticker
    ].iloc[0]

    st.subheader(f"{company['Company']} ({ticker})")

    col1, col2, col3, col4 = st.columns(4)

    col1.metric("Sector", company["Sector"])
    col2.metric("ROE", f"{company['ROE (%)']:.2f}%")
    col3.metric("ROCE", f"{company['ROCE (%)']:.2f}%")
    col4.metric("Debt-to-Equity", f"{company['Debt/Equity']:.2f}")

    col5, col6 = st.columns(2)

    col5.metric(
        "Investment Score",
        f"{company['Investment Score']:.2f}",
    )

    col6.metric(
        "Risk Category",
        company["Risk Category"],
    )

    st.success("Company Profile page loaded successfully.")


# ============================================================
# PAGE 3 — STOCK SCREENER
# ============================================================

def stock_screener_page() -> None:
    show_page_header(
        "🔍 Stock Screener",
        "Filter companies using financial-performance conditions.",
    )

    col1, col2, col3 = st.columns(3)

    sectors = ["All"] + sorted(
        SAMPLE_COMPANIES["Sector"].unique().tolist()
    )

    with col1:
        selected_sector = st.selectbox(
            "Sector",
            sectors,
        )

    with col2:
        minimum_roe = st.number_input(
            "Minimum ROE (%)",
            min_value=0.0,
            max_value=100.0,
            value=10.0,
            step=1.0,
        )

    with col3:
        maximum_de = st.number_input(
            "Maximum Debt-to-Equity",
            min_value=0.0,
            max_value=20.0,
            value=10.0,
            step=0.1,
        )

    result = SAMPLE_COMPANIES.copy()

    if selected_sector != "All":
        result = result[result["Sector"] == selected_sector]

    result = result[
        (result["ROE (%)"] >= minimum_roe)
        & (result["Debt/Equity"] <= maximum_de)
    ]

    st.subheader(f"Screener results: {len(result)} companies")

    st.dataframe(
        result,
        width="stretch",
        hide_index=True,
    )

    csv_data = result.to_csv(index=False).encode("utf-8")

    st.download_button(
        label="Download screener results as CSV",
        data=csv_data,
        file_name="nifty100_screener_results.csv",
        mime="text/csv",
    )


# ============================================================
# PAGE 4 — PEER COMPARISON
# ============================================================

def peer_comparison_page() -> None:
    show_page_header(
        "⚖️ Peer Comparison",
        "Compare selected companies using financial and risk metrics.",
    )

    selected_companies = st.multiselect(
        "Select companies",
        options=SAMPLE_COMPANIES["Ticker"].tolist(),
        default=["TCS", "INFY"],
    )

    if not selected_companies:
        st.warning("Select at least one company.")
        return

    peers = SAMPLE_COMPANIES[
        SAMPLE_COMPANIES["Ticker"].isin(selected_companies)
    ]

    st.dataframe(
        peers,
        width="stretch",
        hide_index=True,
    )

    st.subheader("Investment-score comparison")

    chart_data = peers.set_index("Ticker")[["Investment Score"]]

    st.bar_chart(chart_data)


# ============================================================
# PAGE 5 — FINANCIAL TRENDS
# ============================================================

def financial_trends_page() -> None:
    show_page_header(
        "📈 Financial Trends",
        "View yearly trends for important company metrics.",
    )

    col1, col2 = st.columns(2)

    with col1:
        ticker = company_selector()

    with col2:
        metric = st.selectbox(
            "Select metric",
            [
                "Revenue",
                "Net Profit",
                "Earnings Per Share",
                "Free Cash Flow",
            ],
        )

    trend_data = pd.DataFrame(
        {
            "Year": [2021, 2022, 2023, 2024, 2025],
            metric: [100, 112, 126, 139, 155],
        }
    ).set_index("Year")

    st.subheader(f"{ticker} — {metric}")

    st.line_chart(trend_data)

    st.dataframe(
        trend_data.reset_index(),
        width="stretch",
        hide_index=True,
    )


# ============================================================
# PAGE 6 — SECTOR ANALYSIS
# ============================================================

def sector_analysis_page() -> None:
    show_page_header(
        "🏭 Sector Analysis",
        "Compare average financial performance across sectors.",
    )

    sector_summary = (
        SAMPLE_COMPANIES.groupby("Sector", as_index=False)
        .agg(
            Companies=("Ticker", "count"),
            Average_ROE=("ROE (%)", "mean"),
            Average_ROCE=("ROCE (%)", "mean"),
            Average_Investment_Score=("Investment Score", "mean"),
        )
        .round(2)
    )

    st.dataframe(
        sector_summary,
        width="stretch",
        hide_index=True,
    )

    st.subheader("Average investment score by sector")

    chart_data = sector_summary.set_index("Sector")[
        ["Average_Investment_Score"]
    ]

    st.bar_chart(chart_data)


# ============================================================
# PAGE 7 — CAPITAL ALLOCATION
# ============================================================

def capital_allocation_page() -> None:
    show_page_header(
        "💰 Capital Allocation",
        "Review cash generation, reinvestment and shareholder returns.",
    )

    ticker = company_selector()

    col1, col2, col3, col4 = st.columns(4)

    col1.metric("Operating Cash Flow", "₹24,500 Cr")
    col2.metric("Capital Expenditure", "₹8,200 Cr")
    col3.metric("Free Cash Flow", "₹16,300 Cr")
    col4.metric("Dividend Payout", "32.5%")

    st.subheader(f"{ticker} capital-allocation pattern")

    allocation_data = pd.DataFrame(
        {
            "Category": [
                "Capital Expenditure",
                "Dividends",
                "Debt Repayment",
                "Cash Retained",
            ],
            "Amount": [8200, 4200, 3100, 4800],
        }
    ).set_index("Category")

    st.bar_chart(allocation_data)

    st.success("Capital Allocation page loaded successfully.")


# ============================================================
# PAGE 8 — ANNUAL REPORTS
# ============================================================

def annual_reports_page() -> None:
    """Browse, upload, replace and download company annual reports."""

    show_page_header(
        "📄 Annual Reports",
        "Browse local PDFs, open official links, or upload custom reports.",
    )

    # ---------------------------------------------------------
    # Folder and database paths
    # ---------------------------------------------------------

    project_root = Path(__file__).resolve().parents[2]

    reports_folder = project_root / "reports" / "annual_reports"
	cache_folder = reports_folder / "cache"

	reports_folder.mkdir(parents=True, exist_ok=True)
	cache_folder.mkdir(parents=True, exist_ok=True)

    database_path = project_root / "nifty100.db"

    # ---------------------------------------------------------
    # Read annual-report links from SQLite
    # ---------------------------------------------------------

    documents = pd.DataFrame(
        columns=["company_id", "year", "annual_report"]
    )

    if database_path.exists():
        try:
            with sqlite3.connect(database_path) as connection:
                documents = pd.read_sql_query(
                    """
                    SELECT
                        UPPER(TRIM(company_id)) AS company_id,
                        CAST("Year" AS INTEGER) AS year,
                        Annual_Report AS annual_report
                    FROM documents
                    WHERE company_id IS NOT NULL
                    ORDER BY company_id, year DESC
                    """,
                    connection,
                )

            documents = documents.drop_duplicates(
                subset=["company_id", "year"],
                keep="first",
            )

        except Exception as error:
            st.warning(
                f"Could not read annual-report links from the database: "
                f"{error}"
            )

    # ---------------------------------------------------------
    # Discover local PDF files
    # Expected format: COMPANY_2024.pdf
    # ---------------------------------------------------------

    local_reports = []

    file_pattern = re.compile(
        r"^(.+)_(\d{4})\.pdf$",
        flags=re.IGNORECASE,
    )

    for pdf_path in cache_folder.glob("*.pdf"):
        match = file_pattern.match(pdf_path.name)

        if match:
            local_reports.append(
                {
                    "company_id": match.group(1).upper(),
                    "year": int(match.group(2)),
                    "path": pdf_path,
                }
            )

    local_df = pd.DataFrame(local_reports)

    # ---------------------------------------------------------
    # Create company list using database and local files
    # ---------------------------------------------------------

    companies = set()

    if not documents.empty:
        companies.update(
            documents["company_id"]
            .dropna()
            .astype(str)
            .str.upper()
            .tolist()
        )

    if not local_df.empty:
        companies.update(
            local_df["company_id"]
            .dropna()
            .astype(str)
            .str.upper()
            .tolist()
        )

    if not companies:
        st.warning(
            "No companies were found in the database or reports folder."
        )
        return

    selected_company = st.selectbox(
        "Select company",
        sorted(companies),
    )

    # ---------------------------------------------------------
    # Find available years for selected company
    # ---------------------------------------------------------

    years = set()

    if not documents.empty:
        database_years = documents.loc[
            documents["company_id"] == selected_company,
            "year",
        ].dropna()

        years.update(database_years.astype(int).tolist())

    if not local_df.empty:
        local_years = local_df.loc[
            local_df["company_id"] == selected_company,
            "year",
        ].dropna()

        years.update(local_years.astype(int).tolist())

    # Allow custom years even when not present in database
    current_year = 2026

    years.update(range(2007, current_year + 1))

    selected_year = st.selectbox(
        "Select financial year",
        sorted(years, reverse=True),
    )

    st.subheader(
        f"{selected_company} — Annual Report {selected_year}"
    )

    expected_filename = (
        f"{selected_company}_{selected_year}.pdf"
    )

    report_path = cache_folder / expected_filename

    # ---------------------------------------------------------
    # Display local PDF download
    # ---------------------------------------------------------

    if report_path.exists():
        st.success("The annual-report PDF is available locally.")

        report_data = report_path.read_bytes()

        st.download_button(
            label="📥 Download Annual Report PDF",
            data=report_data,
            file_name=expected_filename,
            mime="application/pdf",
            width="stretch",
        )

        col1, col2 = st.columns(2)

        col1.metric(
            "File name",
            expected_filename,
        )

        col2.metric(
            "File size",
            f"{report_path.stat().st_size / 1_048_576:.2f} MB",
        )

    else:
        st.info(
            "This report is not stored locally. "
            "You can open the official link or upload a PDF below."
        )

    # ---------------------------------------------------------
    # Display official annual-report link
    # ---------------------------------------------------------

    official_url = None

    if not documents.empty:
        matching_document = documents[
            (documents["company_id"] == selected_company)
            & (documents["year"] == selected_year)
        ]

        if not matching_document.empty:
            official_url = matching_document.iloc[0][
                "annual_report"
            ]

    if (
        official_url is not None
        and pd.notna(official_url)
        and str(official_url).strip()
    ):
        st.link_button(
            "🌐 Open Official Annual Report",
            str(official_url),
            width="stretch",
        )
    else:
        st.warning(
            "No official annual-report link is available "
            "for this company and year."
        )

    # ---------------------------------------------------------
    # Upload or replace a custom PDF
    # ---------------------------------------------------------

    st.divider()
    st.subheader("Upload or replace report")

    uploaded_file = st.file_uploader(
        "Choose an annual-report PDF",
        type=["pdf"],
        key=f"upload_{selected_company}_{selected_year}",
    )

    if uploaded_file is not None:
        st.write(
            f"The uploaded file will be saved as "
            f"**{expected_filename}**."
        )

        button_text = (
            "Replace Existing PDF"
            if report_path.exists()
            else "Save PDF"
        )

        if st.button(
            button_text,
            type="primary",
            width="stretch",
        ):
            uploaded_bytes = uploaded_file.getvalue()

            # Basic PDF validation
            if not uploaded_bytes.startswith(b"%PDF"):
                st.error(
                    "The selected file is not a valid PDF."
                )
            else:
                report_path.write_bytes(uploaded_bytes)

                st.success(
                    f"Saved successfully as {expected_filename}"
                )

                st.rerun()

    # ---------------------------------------------------------
    # Show all locally available reports for the company
    # ---------------------------------------------------------

    st.divider()
    st.subheader(
        f"Locally stored reports for {selected_company}"
    )

    if not local_df.empty:
        company_local_reports = (
            local_df[
                local_df["company_id"] == selected_company
            ]
            .sort_values("year", ascending=False)
            .copy()
        )

        if not company_local_reports.empty:
            company_local_reports["filename"] = (
                company_local_reports["path"]
                .apply(lambda path: path.name)
            )

            st.dataframe(
                company_local_reports[
                    ["year", "filename"]
                ],
                hide_index=True,
                width="stretch",
            )
        else:
            st.info(
                "No local PDFs have been added for this company."
            )
    else:
        st.info("No local annual-report PDFs are available.")

# ============================================================
# NAVIGATION
# ============================================================

pages = [
    st.Page(
        home_page,
        title="Home",
        icon="🏠",
        default=True,
    ),
    st.Page(
        company_profile_page,
        title="Company Profile",
        icon="🏢",
        url_path="profile",
    ),
    st.Page(
        stock_screener_page,
        title="Stock Screener",
        icon="🔍",
        url_path="screener",
    ),
    st.Page(
        peer_comparison_page,
        title="Peer Comparison",
        icon="⚖️",
        url_path="peers",
    ),
    st.Page(
        financial_trends_page,
        title="Financial Trends",
        icon="📈",
        url_path="trends",
    ),
    st.Page(
        sector_analysis_page,
        title="Sector Analysis",
        icon="🏭",
        url_path="sectors",
    ),
    st.Page(
        capital_allocation_page,
        title="Capital Allocation",
        icon="💰",
        url_path="capital",
    ),
    st.Page(
        annual_reports_page,
        title="Annual Reports",
        icon="📄",
        url_path="reports",
    ),
]

navigation = st.navigation(
    pages,
    position="sidebar",
    expanded=True,
)

navigation.run()