            "Investment Score": 86.3,
            "Risk Category": "Low Risk",
        },
        {
            "Ticker": "INFY",
            "Company": "Infosys",
            "Sector": "IT Services",
            "ROE (%)": 29.6,
            "ROCE (%)": 38.1,
